"""
Clean GUI Layout System - Maintains original GUI structure with proper function mappings
Maps buttons to application/Core functions (primary), IMG-Editor Tool (secondary), and Shared functions (fallback)
Keeps ALL original buttons, even those without functions yet
"""

import os
from PyQt6.QtWidgets import (
    QWidget, QVBoxLayout, QHBoxLayout, QSplitter, QPushButton, QTableWidget, QTextEdit, QProgressBar, QFrame, QLabel, QSpacerItem, QSizePolicy, QGroupBox
)
from PyQt6.QtCore import Qt, pyqtSignal
from PyQt6.QtGui import QFont

